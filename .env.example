# Supabase → Connect → Connection string. Leave the password out of the URLs.
# App connection: transaction pooler (port 6543)
DATABASE_URL="postgresql://postgres.YOUR-PROJECT-REF@aws-0-YOUR-REGION.pooler.supabase.com:6543/postgres"
# Migrations and seed: session pooler (port 5432)
DIRECT_URL="postgresql://postgres.YOUR-PROJECT-REF@aws-0-YOUR-REGION.pooler.supabase.com:5432/postgres"
# Database password (Project Settings → Database). Special characters are fine.
DB_PASSWORD=""

# Signs login cookies. Generate one with: openssl rand -base64 32
SESSION_SECRET=""
